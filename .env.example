# PostgreSQL (Neon). DATABASE_URL — pooled-соединение для приложения.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"
# DIRECT_URL — прямое соединение (без -pooler) для миграций Prisma.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"
# Секрет для подписи сессионных cookie. В продакшене задать обязательно.
AUTH_SECRET="change-this-secret-in-production"
# Код-приглашение для регистрации учителем (раздаётся доверенным учителям).
# Если не задан — регистрация учителем полностью закрыта.
TEACHER_INVITE_CODE="your-teacher-invite-code"

# Cloudflare R2 (S3-совместимое хранилище загруженных файлов).
R2_ACCOUNT_ID="cloudflare-account-id"
R2_ACCESS_KEY_ID="r2-access-key-id"
R2_SECRET_ACCESS_KEY="r2-secret-access-key"
R2_BUCKET_NAME="ваш-bucket"

# Публичный адрес сайта — для метатегов, robots.txt и sitemap.xml.
# Без протокола не работает. На превью-деплоях Vercel подставляет свой адрес сам.
NEXT_PUBLIC_SITE_URL="https://example.kz"
# Ящик для запросов по персональным данным (указан в политике конфиденциальности).
NEXT_PUBLIC_PRIVACY_EMAIL="privacy@example.kz"

# Отправка писем. Нужен ключ одного из провайдеров — что задано, то и используется.
#
# Вариант без своего домена: Brevo. Подтверждаешь один ящик (можно личный gmail)
# и шлёшь с него на любые адреса. Задай BREVO_API_KEY и EMAIL_FROM с этим ящиком.
BREVO_API_KEY=""
#
# Вариант со своим доменом: Resend. Требует верификации домена, зато письма идут
# с адреса вида noreply@домен. Без верификации шлёт только на почту владельца аккаунта.
RESEND_API_KEY=""
#
# Отправитель в формате «Имя <адрес>». Адрес обязан быть подтверждён у провайдера.
EMAIL_FROM="Olympic Meridian <твой-подтверждённый@gmail.com>"
